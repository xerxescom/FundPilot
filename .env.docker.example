# Docker Compose 配置：copy 成 .env.docker 后按需修改，用
#   docker compose --env-file .env.docker up -d --build
# DOCKER_ 前缀的变量供 compose 插值（端口/库名等）；其余变量通过 env_file 注入容器。

# —— Compose 端口与数据库 ——
DOCKER_POSTGRES_PORT=5432
DOCKER_POSTGRES_DB=fund_watcher
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=postgres
DOCKER_BACKEND_PORT=8000
DOCKER_FRONTEND_PORT=5173
DOCKER_SYNC_NAV_CRON=18:00
DOCKER_ENABLE_SCHEDULER=false
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# 可选：网络受限时用镜像源加速镜像构建（留空使用官方源）
# DOCKER_UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# DOCKER_NPM_REGISTRY=https://registry.npmmirror.com

# —— 应用配置（不带前缀，env_file 直接注入 backend / worker / migrate）——
APP_NAME=FundPilot
SYNC_NAV_CRON=18:00
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=180
# 在线模型密钥只保存在后端环境变量中，不要写进前端
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=90
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus
QWEN_TIMEOUT=90

# —— 批次与 worker ——
WORKER_POLL_SECONDS=2
HEARTBEAT_INTERVAL_SECONDS=15
LEASE_TTL_SECONDS=120
BATCH_ITEM_MAX_RETRIES=3
BATCH_RECOVERY_WINDOW_DAYS=3
INTERRUPTED_REQUEUE_DELAY_SECONDS=30
MARKET_CLOSE_TIME=15:00
FUND_DISCLOSURE_GRACE_TRADE_DAYS=3
MARKET_DATA_GRACE_TRADE_DAYS=1
TRADE_CALENDAR_REFRESH_DAYS=7
